# Salin ke .env lalu sesuaikan: cp .env.example .env
# Jangan commit .env (sudah di-.gitignore).

# --- apps/api ---
PORT=3000
# Masa berlaku sesi login (menit)
SESSION_TTL_MINUTES=60

# Batas percobaan login GAGAL dalam satu jendela waktu (fixed window).
LOGIN_LOCK_WINDOW_MINUTES=15
# Per kombinasi IP + email
LOGIN_MAX_FAILURES_PER_EMAIL=5
# Per IP, lintas email
LOGIN_MAX_FAILURES_PER_IP=20
# Isi hanya bila API berada di belakang reverse proxy tepercaya (mis. 1 = satu hop, atau "loopback").
# Kosong/false = X-Forwarded-For diabaikan, agar IP tidak bisa dipalsukan klien.
TRUST_PROXY=

# User dev yang di-seed saat API start (diabaikan bila NODE_ENV=production).
# User & sesi disimpan in-memory: hilang setiap kali API restart.
SEED_USER_EMAIL=dev@example.com
# Isi sendiri; sengaja dikosongkan agar tidak ada password di repo.
SEED_USER_PASSWORD=

# --- apps/web ---
# Target proxy Vite untuk /api/* (dibaca vite.config.ts, tidak diekspos ke browser)
API_PROXY_TARGET=http://localhost:3000
