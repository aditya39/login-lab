{
    "permissions": {
        "allow": ["Bash(npm test)", "Bash(npm test *)"],
        "ask": ["Bash(git push *)"],
        "deny": ["Read(./.env)"]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh"
                    }
                ]
            }
        ]
    }
}
